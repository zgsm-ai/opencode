# opencode 后端服务地址
VITE_OPENCODE_SERVER_HOST=localhost
VITE_OPENCODE_SERVER_PORT=8080

# costrict-web server 地址，/cloud/device/* 代理到此
VITE_CLOUD_SERVER_HOST=localhost
VITE_CLOUD_SERVER_PORT=8080

# API/cloud 路径前缀，留空则使用 /api 和 /cloud
VITE_API_PREFIX=

# 部署子路径，留空则部署在根路径（例如：/costrict-web-portal）
VITE_BASE_PATH=

# 设置后 baseUrl 自动变为 http://<host>:<port>/cloud/device/<id>/proxy
# 留空则直接连接 VITE_OPENCODE_SERVER_HOST:VITE_OPENCODE_SERVER_PORT
VITE_OPENCODE_CLOUD_DEVICE_ID=

# 前端应用端口及访问地址
VITE_APP_PORT=3000
VITE_APP_URL=http://localhost:3000

