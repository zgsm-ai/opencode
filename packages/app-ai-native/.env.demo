# Demo mode configuration
# All pages use mock data - no backend API required

# Enable demo mode
VITE_DEMO_MODE=true

# Server configuration (not used in demo mode but required by vite config)
VITE_CLOUD_SERVER_HOST=127.0.0.1
VITE_CLOUD_SERVER_PORT=8080

# API prefix (empty for demo mode)
VITE_API_PREFIX=

# Base path
VITE_BASE_PATH=

# Demo server port (separate from dev to avoid conflicts)
VITE_APP_PORT=3001
VITE_APP_URL=http://127.0.0.1:3001
